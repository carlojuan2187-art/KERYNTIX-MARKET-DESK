# API raíz de FastAPI; no añadas un prefijo /v1.
# Desarrollo local: http://localhost:8000. Sustituye por el host HTTPS al desplegar.
VITE_API_URL=http://localhost:8000

# Opcional. URL completa del WebSocket de eventos; por defecto se deriva de VITE_API_URL y usa /ws/events.
# En producción usa wss:// y el mismo host del backend.
VITE_WS_URL=ws://localhost:8000/ws/events

# Nombre público del bot exclusivo de autenticación, sin @. Debe coincidir con TELEGRAM_AUTH_BOT_USERNAME del backend.
VITE_TELEGRAM_BOT_USERNAME=

# Debe coincidir con TRIAL_DAYS del backend. Solo se muestra como información en la interfaz.
VITE_TRIAL_DAYS=5

# Duración visual de las notificaciones emergentes del navegador; no configura el backend.
VITE_ALERT_DURATION_SECONDS=180

# Contactos públicos de soporte. Déjalos vacíos si no quieres publicar teléfonos.
VITE_ADMIN_WHATSAPP_1=
VITE_ADMIN_WHATSAPP_2=
VITE_ADMIN_WHATSAPP_3=

# Opcional: host público que se usa para enlaces compartidos/referidos.
VITE_APP_DOMAIN=
